{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dysky",
  "version": "../package.json",
  "identifier": "com.youlius.dysky",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dysky",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "preventOverflow": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "scrollBarStyle": "fluentOverlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Youlius",
    "copyright": "© 2026 Youlius. MIT License.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "homepage": "https://dysky.youlius.com",
    "shortDescription": "See what takes up the space on your drives",
    "longDescription": "Dysky is a small, read-only disk space viewer for Windows 11. Pick a drive or a folder and see every folder as one interactive ring: click to dive in, search by name, find the largest files. It never changes or deletes anything.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
